    { "id": "day_quote", "op": "preview", "actionId": "commerce:end_day", "parameters": {} },
    { "id": "day", "op": "execute", "previewFrom": "day_quote", "requestId": "qa_day_0001", "confirmed": true },
    { "id": "day_receipt", "op": "wait_receipt", "requestFrom": "day", "timeoutMs": 5000 },
