{
  "schemaVersion": 1,
  "rules": [
      {
        "id": "antigravity-gm-connection-v2",
        "patterns": ["src/antigravityGmClient.ts", "src/antigravityGmProfile.ts", "src/antigravityGmProtocolCore.ts"],
        "tests": ["test_antigravity_gm_client.js", "test_antigravity_gm_protocol.js", "test_gm_connection_host.js", "test_player_agent_mcp.js", "test_vscode_lm_turn_result_core.js"],
        "boundaries": ["compile"],
        "reason": "Native Antigravity auth, isolated configuration and tool-free stream acceptance share existing GM admission. Real account checks remain manual."
      },
      {
        "id": "gm-connection-v2",
      "patterns": ["src/gmConnectionCore.ts", "src/gmConnectionHost.ts", "src/codexAppServerProtocol.ts", "src/codexGmClient.ts", "scripts/probe_codex_gm.js"],
        "tests": ["test_gm_connection.js", "test_gm_connection_host.js", "test_codex_app_server_protocol.js", "test_codex_gm_client.js", "test_runtime_turn_result_acceptance.js", "test_vscode_lm_turn_result_core.js", "test_prompt_receipt_accepted_consumption.js"],
      "boundaries": ["compile"],
      "reason": "GM transport and Host candidate admission must preserve auth, cancellation and Accepted Turn. The live account probe is manual, not an automated model call."
      },
      {
        "id": "claude-gm-connection-v2",
        "patterns": ["src/claudeGmClient.ts", "scripts/probe_claude_gm.js"],
        "tests": ["test_claude_gm_client.js", "test_gm_connection_host.js", "test_player_agent_mcp.js", "test_vscode_lm_turn_result_core.js"],
        "boundaries": ["compile"],
        "reason": "Subscription-only CLI auth, disabled capabilities, bounded stream results and shared Host admission. Actual service calls remain manual."
      },
    {
      "id": "ai-client-packaging",
      "patterns": ["src/aiClientIntegrationCore.ts", "src/playerAgentHost.ts", "src/playerIpcHost.ts", "integrations/lorerelay-player/**", "integrations/README.md", "scripts/build_ai_client_bundle.js", "scripts/build_codex_local_plugin.js", "scripts/pack_ai_client_bundle.py", "scripts/smoke_codex_config.js", "scripts/smoke_gemini_connection.js", "scripts/smoke_grok_connection.js"],
      "tests": ["test_ai_client_integration.js", "test_ai_connection_status.js", "test_ai_client_bundle.js", "test_player_agent_mcp.js"],
      "boundaries": ["compile"],
      "reason": "Client configuration, fixed-role packaging and Host pairing require SDK isolation checks. Vendor application smoke is a separate explicitly launched check."
    },
    {
      "id": "mcp-public-resources",
      "patterns": ["src/mcpAdapter.ts", "src/companionMcp.ts", "src/publicGameGraphicCore.ts", "src/commerceActionRuntime.ts"],
      "tests": ["test_ai_client_bundle.js", "test_mcp_public_events.js", "test_public_game_graphic.js", "test_player_agent_mcp.js"],
      "boundaries": ["compile"],
      "reason": "Public resources and images must retain role boundaries, fog projection and portable dependencies."
    },
    {
      "id": "player-lab",
      "patterns": ["src/playerLabCore.ts", "scripts/run_player_lab.js", "scripts/compare_player_lab.js", "integrations/player-lab-task.md", "fixtures/action-scenarios/player_lab_support_v1/**", "scripts/smoke_codex_play.js", "scripts/smoke_grok_play.js"],
      "tests": ["test_player_lab.js", "test_player_lab_runner.js", "test_player_lab_support.js"],
      "boundaries": ["compile"],
      "reason": "Fixture comparison, receipt aggregation and session cleanup require bounded SDK runner checks. Actual model play is not run by the test selector."
    },
    {
      "id": "remote-ai-gateway",
      "patterns": ["src/remoteAiGateway.ts", "src/remoteTunnelWitness.ts", "src/mcpAdapter.ts", "src/playerAgentHost.ts"],
      "tests": ["test_remote_ai_gateway.js", "test_remote_tunnel_witness.js"],
      "boundaries": ["compile"],
      "reason": "Remote pairing, role boundaries and connection invalidation require local SDK and tunnel-witness checks. External HTTPS connectivity is verified separately."
    },
    {
      "id": "ai-voice-client",
      "patterns": ["src/voiceCompanionCore.ts", "integrations/voice-client.*", "scripts/serve_voice_client.js", "scripts/smoke_voice_browser.js"],
      "tests": ["test_voice_companion.js", "test_voice_client.js", "test_remote_ai_gateway.js"],
      "boundaries": ["compile"],
      "reason": "Voice consent, fixed read-only configuration and audio lifecycle are checked without external API calls. Real microphone and xAI tests remain separate."
    },
    {
      "id": "chat-native-card",
      "patterns": ["src/chatNativeCard.ts", "scripts/render_chat_card.js"],
      "tests": ["test_chat_native_card.js", "test_remote_ai_gateway.js"],
      "boundaries": ["compile"],
      "reason": "Public chat UI rendering and Gateway resource metadata share a read-only boundary."
    },
    {
      "id": "ui-presentation",
      "patterns": ["src/uiPresentationCore.ts", "webview/modules/04-ui-presentation.js", "webview/modules/06-genesis-guide.js", "webview/modules/84b-responsive-shell.js", "webview/styles/9d-ui-presentation.css", "scripts/build-webview.js"],
      "tests": ["test_ui_presentation.js", "test_webview_responsive_narrow.js", "test_webview_bundle.js", "test_world_genesis_setup.js", "validate_webview_html_structure.js"],
      "boundaries": ["compile", "symbol-registry", "i18n"],
      "reason": "UI-only preferences, Genesis recommendation and responsive composition share existing gameplay components."
    },
    {
      "id": "player-agent-mcp",
      "patterns": ["src/player*.ts", "src/narratorMcp.ts", "src/mcpAdapter.ts", "src/gameActionService.ts", "src/experience.ts", ".vscodeignore"],
      "tests": ["test_player_agent_mcp.js", "test_game_action_commerce.js", "test_action_recorder.js", "test_command_palette_gating.js"],
      "boundaries": ["compile", "symbol-registry"],
      "reason": "Player delegation, local IPC and official stdio adapters require authority, commerce, observation and packaging checks."
    },
    {
      "id": "action-recorder",
      "patterns": ["src/actionRecorder*.ts", "src/gameActionService.ts", "scripts/run_action_scenario.js", "scripts/action_scenarios/recorded_merchant_v1.json"],
      "tests": ["test_action_recorder.js", "test_game_action_commerce.js", "test_command_palette_gating.js"],
      "boundaries": ["compile", "symbol-registry"],
      "reason": "Human action observation, sanitized templates and fixture replay changed."
    },
    {
      "id": "live-extension-qa",
      "patterns": ["src/liveExtensionQa*.ts", "src/liveQaProbeHost.ts", "scripts/live_qa_mods_scenario.js", "scripts/run_live_extension_qa.js", ".github/workflows/live-extension-qa.yml"],
      "tests": ["test_live_extension_qa.js", "test_checkpoint_complete_state_snapshot.js", "test_game_action_commerce.js", "test_deterministic_workspace_mutation_gate.js"],
      "boundaries": ["compile", "symbol-registry"],
      "reason": "Live fixture IPC, production checkpoint ownership and lifecycle boundaries changed; real Host validation runs separately."
    },
    {
      "id": "commerce-action-driver",
      "patterns": ["src/gameActionService.ts", "src/commerceAction*.ts", "src/publishedMarketLocationsCore.ts", "scripts/action_scenario_fixture.js", "scripts/run_action_scenario.js", "scripts/action_scenarios/**", "fixtures/action-scenarios/**"],
      "tests": ["test_game_action_commerce.js", "test_market_travel_core.js", "test_end_day_world_progression.js", "test_shopkeeper_repair.js", "test_playable_v0_player_action_hub.js"],
      "boundaries": ["compile", "symbol-registry"],
      "reason": "Commerce action authority, production persistence, confirmation, replay and fixture isolation changed."
    },
    {
      "id": "test-console",
      "patterns": ["tools/test-console/**", "LoreRelay_Test_Console.bat"],
      "tests": ["test_test_console.js"],
      "boundaries": ["utf8-docs"],
      "reason": "Test Console implementation or launcher changed."
    },
    {
      "id": "test-runner",
      "patterns": ["scripts/run_all_tests.js", "scripts/simulation_test_manifest.js", "scripts/run_simulation_tests.js"],
      "tests": ["test_test_console.js"],
      "reason": "Shared test manifest or runner behavior changed."
    },
    {
      "id": "webview-modules",
      "patterns": ["webview/modules/**"],
      "tests": ["test_webview_bundle.js", "test_webview_world_modules.js", "test_webview_handlers_core.js"],
      "boundaries": ["compile", "webview-parity", "i18n"],
      "reason": "Generated webview modules require bundle and host-contract coverage."
    },
    {
      "id": "webview-styles",
      "patterns": ["webview/styles/**"],
      "tests": ["test_webview_bundle.js", "test_webview_genre_chrome.js", "test_relay_viewport_theme_layout.js"],
      "boundaries": ["compile", "webview-parity"],
      "reason": "Webview styling requires generated bundle and layout parity checks."
    },
    {
      "id": "webview-battle-view",
      "patterns": ["webview/battle-view/**"],
      "tests": ["combat:command-playtest", "test_webview_bundle.js"],
      "boundaries": ["compile", "webview-parity"],
      "reason": "Dedicated Battle View assets require command-playtest adapter coverage and packaging parity, not a full suite."
    },
    {
      "id": "webview-shell",
      "patterns": ["webview/script.js", "webview/style.css", "webview/app.js"],
      "tests": ["test_webview_bundle.js", "test_webview_handlers_core.js"],
      "boundaries": ["compile", "webview-parity", "i18n"],
      "reason": "Top-level webview shell scripts and styles require bundle and host-contract coverage."
    },
    {
      "id": "webview-assets",
      "patterns": ["webview/assets/**"],
      "tests": ["test_webview_bundle.js"],
      "boundaries": ["webview-parity"],
      "reason": "Static webview assets require packaging parity checks."
    },
    {
      "id": "webview-index",
      "patterns": ["webview/index.html"],
      "tests": ["test_webview_bundle.js", "validate_webview_html_structure.js"],
      "boundaries": ["compile", "webview-parity", "i18n"],
      "reason": "The webview document boundary changed."
    },
    {
      "id": "locales",
      "patterns": ["locales/**", "package.nls*.json"],
      "tests": ["check_i18n_keys.js"],
      "boundaries": ["i18n", "utf8-docs"],
      "reason": "Locale resources require key and encoding validation."
    },
    {
      "id": "typescript-source",
      "patterns": ["src/**"],
      "tests": ["validate.js"],
      "boundaries": ["compile", "symbol-registry", "i18n"],
      "reason": "Packaged TypeScript source changed; compile and contract validation are required."
    },
    {
      "id": "combat-runtime",
      "patterns": ["src/gambitCombatCore.ts", "src/combat*.ts", "src/combat*.test.ts", "src/*Combat*.test.ts"],
      "boundaries": ["compile", "symbol-registry", "combat-manifest-coverage"],
      "reason": "Combat subsystem source or test changed; focused Combat groups (selected by combat-group inference), manifest coverage, and Symbol Registry are required."
    },
    {
      "id": "combat-manifest",
      "patterns": ["scripts/combat_test_manifest.js"],
      "tests": ["test_combat_manifest_coverage.js"],
      "boundaries": ["compile"],
      "reason": "Combat test group registration changed; the manifest coverage guard must run directly, against freshly compiled output."
    },
    {
      "id": "combat-docs",
      "patterns": ["docs/COMBAT_*.md"],
      "boundaries": ["utf8-docs"],
      "reason": "Combat design documentation changed."
    },
    {
      "id": "test-script",
      "patterns": ["scripts/test_*.js", "scripts/test_*.py", "scripts/validate_*.js", "scripts/check_*.js"],
      "testsFromChangedFiles": true,
      "reason": "Changed test or validator must execute directly."
    },
    {
      "id": "installer",
      "patterns": ["installer/**", "scripts/*installer*.js", "scripts/*installer*.ps1", "scripts/install*.ps1", "scripts/test_antigravity_install*.js", "scripts/test_*installer*.js"],
      "tests": ["test_antigravity_installer.js", "test_antigravity_installer_bootstrap.js", "test_antigravity_skill_installer.js", "test_antigravity_install_chain.js"],
      "boundaries": ["version-consistency", "utf8-docs"],
      "reason": "Installer logic requires hermetic installer coverage and serialized worktree access.",
      "exclusiveGroup": "installer-worktree"
    },
    {
      "id": "symbol-registry",
      "patterns": ["docs/generated/symbol_registry.json", "docs/generated/SYMBOL_REGISTRY.md", "docs/generated/symbol-registry.json", "scripts/generate_symbol_registry.js", "symbol-registry.json"],
      "tests": ["test_symbol_registry.js"],
      "boundaries": ["symbol-registry"],
      "reason": "Generated symbol registry or its generator changed."
    },
    {
      "id": "release-truth",
      "patterns": ["package.json", "package-lock.json", "CHANGELOG.md", "RELEASE*.md", "docs/release/**", "scripts/check_version_consistency.js"],
      "tests": ["check_version_consistency.js"],
      "boundaries": ["version-consistency", "utf8-docs"],
      "reason": "Package or release-truth data changed."
    },
    {
      "id": "sample-scenarios",
      "patterns": ["sample-scenarios/**", "samples/**", "scenarios/**"],
      "tests": ["test_sample_scenarios.js", "test_scrapbound_sample_integrity.js"],
      "boundaries": ["utf8-docs"],
      "reason": "Sample scenario content requires integrity and encoding checks."
    },
    {
      "id": "simulation-noai",
      "patterns": ["scripts/run_noai_*.js", "scripts/noai_**", "src/*Simulation*.ts", "src/*Simulator*.ts", "src/*World*.ts"],
      "tests": ["test_determinism_spine_core.js", "test_noai_soak_runner_core.js", "run_simulation_tests.js"],
      "boundaries": ["compile"],
      "reason": "Simulation or NOAI behavior changed.",
      "exclusiveGroup": "simulation-stress"
    },
    {
      "id": "documentation",
      "patterns": ["docs/**", "README.md", "CONTRIBUTING.md", "SECURITY.md", "LICENSE*", "AGENTS.md"],
      "tests": ["validate_utf8_docs.js"],
      "boundaries": ["utf8-docs"],
      "reason": "Documentation-only changes require UTF-8 validation."
    },
    {
      "id": "tooling-config",
      "patterns": [".gitignore", ".github/**", "tsconfig.json", ".vscodeignore"],
      "tests": ["validate_utf8_docs.js"],
      "reason": "Repository tooling configuration changed."
    }
  ],
  "boundaries": {
    "compile": {
      "id": "boundary:compile",
      "category": "validate"
    },
    "webview-parity": {
      "test": "test_webview_bundle.js"
    },
    "symbol-registry": {
      "id": "boundary:symbol-registry",
      "category": "validate"
    },
    "combat-manifest-coverage": { "test": "test_combat_manifest_coverage.js" },
    "i18n": { "test": "check_i18n_keys.js" },
    "version-consistency": { "test": "check_version_consistency.js" },
    "utf8-docs": { "test": "validate_utf8_docs.js" }
  }
}
